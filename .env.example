# PostgreSQL connection string.
# Local example: postgresql://USER:PASSWORD@localhost:5432/finance
# Or use a free hosted Postgres (Neon, Supabase, Railway) and paste its URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance?schema=public"

# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (use your deployed URL in production).
NEXTAUTH_URL="http://localhost:3000"
